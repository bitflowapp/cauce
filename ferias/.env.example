# CAUCE · Ferias — variables sólo para el build remoto (npm run build).
# El desarrollo local no necesita ninguna: lee el stack con `npx supabase status`.
# Nunca pongas acá una secret key ni la service_role: el build las rechaza.
FERIAS_SUPABASE_URL=https://<ref-del-proyecto-de-ferias>.supabase.co
FERIAS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
FERIAS_SITE_URL=https://<dominio-del-sitio>
# Opcionales
# FERIAS_RELEASE=v0.1.0
# FERIAS_OUT_DIR=dist
