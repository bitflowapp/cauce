# CAUCE · variables de entorno. Copiá este archivo a `.env` sólo si lo necesitás
# para tu propia terminal: los scripts leen el entorno del proceso, NO cargan
# `.env` solos, y `.env` nunca se versiona. Acá no hay ni debe haber secretos.
#
# Ningún valor es obligatorio para desarrollar: sin nada definido, el build de
# producción usa supabase/project.json (URL y publishable key del proyecto real,
# públicas por diseño) y el stack local se descubre con `npx supabase status`.

# ── Build de producción (scripts/build-production.mjs) ──────────────────────
# URL del proyecto Supabase. Debe ser https://<ref>.supabase.co (o localhost en
# pruebas). El build falla si no lo es.
CAUCE_SUPABASE_URL=
# Publishable key (sb_publishable_…) o anon key. El build RECHAZA una secret
# key o una service_role: en el navegador sólo va la clave pública, y la
# seguridad la ponen RLS y las funciones del servidor.
CAUCE_SUPABASE_PUBLISHABLE_KEY=
# URL pública donde se sirve la app: define los enlaces de los correos de
# confirmación y recuperación, canonical y OpenGraph.
CAUCE_SITE_URL=https://bitflowapp.github.io/cauce
# Carpeta de salida (por defecto dist-production/, o .local/preview con --local).
CAUCE_OUT_DIR=
# Identificador de versión que se muestra en el pie y en los reportes de error
# (por defecto, el commit corto).
CAUCE_RELEASE=

# ── Operación del proyecto real (sólo quien administra; nunca en CI ni acá) ──
# Token personal de https://supabase.com/dashboard/account/tokens. Lo usan
# scripts/configure-auth.mjs y `npx supabase link`. Exportalo en la terminal
# en el momento y no lo guardes en ningún archivo del repositorio.
SUPABASE_ACCESS_TOKEN=
# SMTP propio para confirmación y recuperación de contraseña (ver
# PRODUCTION_READINESS.md). Los cinco van juntos o ninguno.
CAUCE_SMTP_HOST=
CAUCE_SMTP_PORT=
CAUCE_SMTP_USER=
CAUCE_SMTP_PASS=
CAUCE_SMTP_SENDER=
# Topes de Auth por hora (opcionales).
CAUCE_ANONYMOUS_RATE_LIMIT=150
CAUCE_EMAIL_RATE_LIMIT=30

# ── Pruebas contra un stack local que no es el de `npx supabase status` ─────
# El arnés de integración RECHAZA cualquier host que no sea 127.0.0.1 o
# localhost: nunca corre contra el proyecto real. Son claves del stack local.
CAUCE_TEST_SUPABASE_URL=
CAUCE_TEST_PUBLISHABLE_KEY=
CAUCE_TEST_SECRET_KEY=
CAUCE_TEST_DB_URL=
CAUCE_TEST_MAILPIT_URL=
CAUCE_TEST_JWT_SECRET=
# Navegadores de la E2E (por defecto chromium,webkit) y ruta de Chrome para las
# suites heredadas de la demostración.
CAUCE_E2E_BROWSERS=chromium,webkit
CAUCE_CHROME_PATH=
